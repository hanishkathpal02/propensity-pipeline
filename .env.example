# Copy to .env and fill in. .env is gitignored — never commit real values.

# Environment: dev | prod  (controls which Klaviyo API key is used)
ENV=dev

# Redshift — warehouse/analytics cluster (redshift-cluster-angara, db: dev).
# Hosts propensity.*, profiles.*, reporting.*, and the shared_klaviyo datashare.
REDSHIFT_HOST_DEV=
REDSHIFT_PORT_DEV=5439
REDSHIFT_DB_DEV=dev
REDSHIFT_USER_DEV=
REDSHIFT_PASS_DEV=

# S3 — staging bucket for the verification COPY round-trip
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REGION_NAME=
BUCKET_NAME=

# Klaviyo Profile API
KLAVIYO_SANDBOX_API_KEY=
KLAVIYO_API_KEY=
